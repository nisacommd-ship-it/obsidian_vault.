---
import { useT } from '@/i18n/ui';
import { pathFor, type Locale } from '@/i18n/routes';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
---
<div class="cookie" role="dialog" aria-live="polite" aria-label="Cookie" data-cookie hidden>
  <p>{t('cookie.text')} <a href={pathFor('cookies', lang)}>{t('cookie.more')}</a></p>
  <div class="btn-row">
    <button type="button" class="btn btn--outline" data-cookie-choice="necessary">{t('cookie.necessary')}</button>
    <button type="button" class="btn" data-cookie-choice="all">{t('cookie.accept')}</button>
  </div>
</div>
<style>
  .cookie { position: fixed; z-index: 60; left: 8px; right: 8px; bottom: 64px; max-width: 520px; background: var(--white); border: 1px solid var(--line); box-shadow: 0 10px 40px rgba(47, 50, 53, .16); padding: 14px 16px; font-size: 14px; line-height: 1.45; }
  .cookie p { margin-bottom: 10px; }
  .cookie .btn-row { flex-wrap: nowrap; gap: 8px; }
  .cookie .btn { flex: 1 1 0; min-height: 44px; padding: 8px 10px; font-size: 14px; }
  @media (min-width: 1024px) { .cookie { left: 24px; bottom: 24px; } }
</style>
