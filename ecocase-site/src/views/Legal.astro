---
import type { Locale } from '@/i18n/routes';
import { useT } from '@/i18n/ui';
interface Props { lang: Locale; doc: { h1: string; updated: string; sections: { h: string; p: string[] }[] } }
const { lang, doc } = Astro.props;
const t = useT(lang);
---
<section class="section" style="padding-top:32px">
  <div class="container prose">
    <h1>{doc.h1}</h1>
    <p class="muted">{t('updated')}: <time datetime={doc.updated}>{doc.updated}</time></p>
    {doc.sections.map((s) => <><h2>{s.h}</h2>{s.p.map((p) => <p>{p}</p>)}</>)}
  </div>
</section>
