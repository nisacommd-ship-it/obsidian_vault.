---
import { useT } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';
interface Props { lang: Locale; items: { q: string; a: string }[]; title?: string; id?: string }
const { lang, items, title, id = 'faq' } = Astro.props;
const t = useT(lang);
---
<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <div class="container faq">
    <div>
      <span class="eyebrow">FAQ</span>
      <h2 id={`${id}-h`}>{title ?? t('faq.title')}</h2>
    </div>
    <div class="faq__list">
      {items.map((f, i) => (
        <details open={i === 0}>
          <summary><h3>{f.q}</h3></summary>
          <div class="faq__a"><p set:html={f.a} /></div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .faq { display: grid; gap: 32px; }
  @media (min-width: 1024px) { .faq { grid-template-columns: 1fr 2fr; gap: 64px; } }
  details { border-bottom: 1px solid var(--line); }
  details:first-child { border-top: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; padding: 20px 44px 20px 0; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary h3 { margin: 0; font-size: 19px; color: var(--graphite); font-weight: 500; }
  summary::after { content: ''; position: absolute; right: 8px; top: 50%; width: 14px; height: 14px; border-right: 1.5px solid var(--green); border-bottom: 1.5px solid var(--green); transform: translateY(-70%) rotate(45deg); transition: transform .2s; }
  details[open] summary::after { transform: translateY(-30%) rotate(-135deg); }
  .faq__a { padding: 0 0 20px; max-width: 70ch; }
</style>
