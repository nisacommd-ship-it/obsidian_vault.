---
import { SITE } from '@/config/site';
import { useT } from '@/i18n/ui';
import type { Locale } from '@/i18n/routes';
interface Props { lang: Locale }
const t = useT(Astro.props.lang);
---
<nav class="fab" aria-label="Contact">
  <a href={`tel:${SITE.phone}`} data-track="phone_click">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2"/></svg>
    <span>{t('float.call')}</span>
  </a>
  <a href={SITE.whatsapp} rel="noopener" data-track="messenger_click" data-channel="whatsapp">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.6-2-1-1 1a4 4 0 0 1-2.4-2.4l1-1-1-2z"/></svg>
    <span>WhatsApp</span>
  </a>
  <a href={SITE.viber} data-track="messenger_click" data-channel="viber">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2.5c5 0 8.5 2 8.5 8s-3.5 8-8.5 8l-3 2.5v-3C5 17 3.5 14.5 3.5 10.5 3.5 4.5 7 2.5 12 2.5z"/><path d="M9.5 7.5c0 3.6 2.4 6 6 6l.8-1.3-1.7-.9-.8.8a3.4 3.4 0 0 1-1.9-1.9l.8-.8-.9-1.7z"/></svg>
    <span>Viber</span>
  </a>
</nav>
<style>
  .fab { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: repeat(3, 1fr); background: var(--green); padding-bottom: env(safe-area-inset-bottom); }
  .fab a { display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 56px; color: var(--white); text-decoration: none; font-size: 15px; font-weight: 500; }
  .fab a + a { border-left: 1px solid rgba(228, 213, 188, .3); }
  @media (min-width: 1024px) { .fab { display: none; } }
</style>
