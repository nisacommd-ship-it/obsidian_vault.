---
import { THANKS } from '@/content/pages';
import { pathFor, type Locale } from '@/i18n/routes';
interface Props { lang: Locale }
const { lang } = Astro.props;
const c = THANKS[lang];
---
<section class="section">
  <div class="container prose">
    <h1>{c.h1}</h1>
    <p class="lead">{c.text}</p>
    <div class="btn-row"><a class="btn" href={pathFor('technology', lang)}>{c.next}</a><a class="btn btn--outline" href={`/${lang}/`}>{c.back}</a></div>
  </div>
</section>
