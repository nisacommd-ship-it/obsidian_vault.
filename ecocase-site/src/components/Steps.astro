---
interface Props { steps: { t: string; d: string }[] }
const { steps } = Astro.props;
---
<ol class="steps">
  {steps.map((s, i) => (
    <li class="reveal"><span class="steps__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></li>
  ))}
</ol>
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; counter-reset: s; }
  @media (min-width: 768px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1200px) { .steps { grid-template-columns: repeat(5, 1fr); } }
  .steps li { margin: 0; border-top: 2px solid var(--green); padding-top: 16px; }
  .steps__n { display: block; font-size: 15px; font-weight: 500; color: var(--green); letter-spacing: .1em; margin-bottom: 8px; }
  .steps h3 { font-size: 20px; margin-bottom: 6px; }
  .steps p { margin: 0; font-size: 16px; color: var(--graphite); }
</style>
